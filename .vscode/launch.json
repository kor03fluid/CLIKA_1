{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. C 시험 서버: 가상 시연 (demo, 보드 없이)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pc/server.py",
      "args": [
        "--virtual",
        "demo"
      ],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    },
    {
      "name": "2. C 시험 서버: 환경 노드 USB 연결 (COM 입력)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pc/server.py",
      "args": [
        "--serial",
        "${input:comPort}"
      ],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    },
    {
      "name": "3. C 시험 서버: 환경 노드 USB + 가상 병사 2명",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pc/server.py",
      "args": [
        "--serial",
        "${input:comPort}",
        "--virtual",
        "normal",
        "--virtual-nodes",
        "halo_01,halo_02"
      ],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    },
    {
      "name": "4. 팀장 서버로 펌웨어 JSON 예시 보내기 (팀장 서버 먼저 실행)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pc/send_ndjson.py",
      "args": [
        "${input:ndjsonFile}"
      ],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    },
    {
      "name": "5. 로그 요약 (report.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pc/report.py",
      "args": [
        "${input:logDir}"
      ],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    },
    {
      "name": "6. 단위 테스트",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "tests"
      ],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    },
    {
      "name": "7. 팀장 관제 서버 (공식, squad-link, 8080)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/squad-link/server.mjs",
      "cwd": "${workspaceFolder}/squad-link",
      "console": "integratedTerminal"
    },
    {
      "name": "8. 팀장 USB 브리지 (보드 → 팀장 서버, config/system.json 설정 먼저)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/squad-link/communication/serial_bridge.py",
      "cwd": "${workspaceFolder}/squad-link",
      "console": "integratedTerminal"
    },
    {
      "name": "10. 환경 보드 USB → C 검증 → 팀장 서버 전달 (가상 데이터)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pc/server.py",
      "args": [
        "--serial",
        "${input:comPort}",
        "--forward-lead",
        "http://127.0.0.1:8080/api/ingest"
      ],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "comPort",
      "type": "promptString",
      "description": "환경 노드 COM 포트 (장치 관리자 > 포트에서 확인, 예: COM5)",
      "default": "COM5"
    },
    {
      "id": "ndjsonFile",
      "type": "pickString",
      "description": "보낼 예시 (팀장 서버 input.mode와 출처를 맞추기: 기본 simulation)",
      "options": [
        "../docs/lead_handoff/samples_simulation.ndjson",
        "../docs/lead_handoff/samples_device.ndjson"
      ],
      "default": "../docs/lead_handoff/samples_simulation.ndjson"
    },
    {
      "id": "logDir",
      "type": "promptString",
      "description": "요약할 로그 폴더 (pc/logs 아래 시작 시각 폴더, 예: logs/20261010-120000)",
      "default": "logs/"
    }
  ],
  "compounds": [
    {
      "name": "9. 팀장 관제 서버 + C 시험 서버(가상 시연) 같이 켜기",
      "configurations": [
        "7. 팀장 관제 서버 (공식, squad-link, 8080)",
        "1. C 시험 서버: 가상 시연 (demo, 보드 없이)"
      ],
      "stopAll": true
    },
    {
      "name": "11. 팀장 관제 서버 + 환경 보드 전달(10번) 같이 켜기",
      "configurations": [
        "7. 팀장 관제 서버 (공식, squad-link, 8080)",
        "10. 환경 보드 USB → C 검증 → 팀장 서버 전달 (가상 데이터)"
      ],
      "stopAll": true
    }
  ]
}
