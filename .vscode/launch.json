{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. C 시험 서버: 가상 시연 (demo, 보드 없이)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pc/server.py",
      "args": ["--virtual", "demo"],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    },
    {
      "name": "2. C 시험 서버: 환경 노드 USB 연결 (COM 입력)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pc/server.py",
      "args": ["--serial", "${input:comPort}"],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    },
    {
      "name": "3. C 시험 서버: 환경 노드 USB + 가상 병사 2명",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pc/server.py",
      "args": ["--serial", "${input:comPort}", "--virtual", "normal", "--virtual-nodes", "halo_01,halo_02"],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    },
    {
      "name": "4. 팀장 서버로 펌웨어 JSON 예시 보내기 (팀장 서버 먼저 실행)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pc/send_ndjson.py",
      "args": ["${input:ndjsonFile}"],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    },
    {
      "name": "5. 로그 요약 (report.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pc/report.py",
      "args": ["${input:logDir}"],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    },
    {
      "name": "6. 단위 테스트",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests"],
      "cwd": "${workspaceFolder}/pc",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "comPort",
      "type": "promptString",
      "description": "환경 노드 COM 포트 (장치 관리자 > 포트에서 확인, 예: COM5)",
      "default": "COM5"
    },
    {
      "id": "ndjsonFile",
      "type": "pickString",
      "description": "보낼 예시 (팀장 서버 input.mode와 출처를 맞추기: 기본 simulation)",
      "options": ["../docs/lead_handoff/samples_simulation.ndjson", "../docs/lead_handoff/samples_device.ndjson"],
      "default": "../docs/lead_handoff/samples_simulation.ndjson"
    },
    {
      "id": "logDir",
      "type": "promptString",
      "description": "요약할 로그 폴더 (pc/logs 아래 시작 시각 폴더, 예: logs/20261010-120000)",
      "default": "logs/"
    }
  ]
}
